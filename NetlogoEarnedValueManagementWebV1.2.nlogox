  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <postRun><![CDATA[csv:to-file (word "output/" behaviorspace-run-number "tasks.csv") [ (list behaviorspace-run-number employees-number assigned-tasks-employee probability-of-delay probability-of-advance task-number project-breakdown-code task-description planned-start planned-finish planned-hours (ifelse-value planned-hours > 0 [complete-hours / planned-hours] [0]) actual-hours AC PV EV SV SPI CV CPI ticks) ] of tasks]]></postRun>
      <exitCondition>count tasks with [color = green] = count tasks</exitCondition>
      <metrics>
        <metric>AC</metric>
        <metric>PV</metric>
        <metric>EV</metric>
        <metric>SV</metric>
        <metric>SPI</metric>
        <metric>CV</metric>
        <metric>CPI</metric>
        <metric>ticks</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="employees-number" first="1" step="1" last="7"></steppedValueSet>
        <steppedValueSet variable="assigned-tasks-employee" first="1" step="1" last="3"></steppedValueSet>
        <steppedValueSet variable="probability-of-delay" first="0" step="0.1" last="0.9"></steppedValueSet>
        <steppedValueSet variable="probability-of-advance" first="0" step="0.1" last="0.9"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="experiment_small" repetitions="1" sequentialRunOrder="false" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <postRun><![CDATA[csv:to-file (word "output/" behaviorspace-run-number "tasks.csv") [ (list behaviorspace-run-number employees-number assigned-tasks-employee probability-of-delay probability-of-advance task-number project-breakdown-code task-description planned-start planned-finish planned-hours (ifelse-value planned-hours > 0 [complete-hours / planned-hours] [0]) actual-hours AC PV EV SV SPI CV CPI ticks) ] of tasks]]></postRun>
      <exitCondition>count tasks with [color = green] = count tasks</exitCondition>
      <metrics>
        <metric>count tasks with [status = "to-do"]</metric>
        <metric>count tasks with [status = "in-progress"]</metric>
        <metric>count tasks with [status = "done"]</metric>
        <metric>AC</metric>
        <metric>PV</metric>
        <metric>EV</metric>
        <metric>SV</metric>
        <metric>SPI</metric>
        <metric>CV</metric>
        <metric>CPI</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="employees-number">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="number-of-tasks">
          <value value="200"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="assigned-tasks-employee">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="probability-of-advance">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="probability-of-delay">
          <value value="0.2"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="regression-no-delay" repetitions="3" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>random-seed behaviorspace-run-number setup</setup>
      <go>go</go>
      <metrics>
        <metric>ticks</metric>
        <metric>PMB-Duration</metric>
        <metric>count tasks</metric>
        <metric>count tasks with [status = "done"]</metric>
        <metric>count tasks with [status != "to-do" and not ready?]</metric>
        <metric>count tasks with [finish-violation?]</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-of-tasks">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="probability-of-delay">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="probability-of-advance">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="employees-number">
          <value value="1"></value>
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="assigned-tasks-employee">
          <value value="1"></value>
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="dependency-probability">
          <value value="0"></value>
          <value value="0.5"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
