    <monitor x="896" precision="17" y="599" height="60" fontSize="11" width="136" display="Estimate to Complete">ETC</monitor>
    <monitor x="1074" precision="17" y="599" height="60" fontSize="11" width="135" display="Variance at Completion">VAC</monitor>
