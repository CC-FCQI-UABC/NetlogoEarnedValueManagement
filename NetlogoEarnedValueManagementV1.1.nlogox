        <setup></setup>
        <update>plot EV%</update>
      </pen>
    </plot>
    <monitor x="775" precision="17" y="10" height="60" fontSize="11" width="145" display="Planned Value">PV</monitor>
    <monitor x="775" precision="17" y="75" height="60" fontSize="11" width="100" display="Earned Value">EV</monitor>
    <monitor x="928" precision="17" y="10" height="60" fontSize="11" width="148" display="Actual Cost">AC</monitor>
    <monitor x="0" precision="17" y="330" height="60" fontSize="11" width="276" display="Budget at Completion">BAC</monitor>
    <monitor x="880" precision="17" y="75" height="60" fontSize="11" width="109" display="Schedule Variance">SV</monitor>
    <monitor x="994" precision="17" y="75" height="60" fontSize="11" width="100" display="Cost Variance">CV</monitor>
