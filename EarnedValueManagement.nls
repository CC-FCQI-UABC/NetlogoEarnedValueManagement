;; Budget at Completion: total planned hours of all tasks (planned hours never change, so it is
;; calculated once at setup, see set-baseline)
to-report BAC
  report bac-total
end

;; Performance Measurement Baseline duration (in ticks). Frozen at setup (see set-baseline)
;; so moving sliders mid-run does not rewrite history.
to-report PMB-Duration
  report pmb-baseline
end

;; Called once at the end of setup: the baseline duration is the planned finish
;; (in ticks) of the last task of the plan.
to set-baseline
  set bac-total sum [planned-hours] of tasks
  set cache-tick -1
  set cache-es-tick -1
  ifelse any? tasks
    [set pmb-baseline max [finish-tick] of tasks]
    [set pmb-baseline 0]
  build-pv-curve
end

;; The baseline planned value is piecewise linear in time: every task earns its planned hours
;; linearly between its planned start and finish (a task with no duration earns them at its finish).
;; It is built once at setup as sorted events [tick, value after the event, earning rate after the
;; event], so that the planned value at any time is a binary search instead of a sum over all tasks.
to build-pv-curve
  set pv-event-ticks []
  set pv-event-values []
  set pv-event-rates []
  if not any? tasks [stop]
  let events reduce [[a b] -> sentence a b] [task-pv-events] of tasks
  set events sort-by [[a b] -> first a < first b] events
  let value 0
  let rate 0
  let last-tick first first events
  foreach events [ event ->
    let tk first event
    set value value + rate * (tk - last-tick) + item 2 event
    set rate rate + item 1 event
    set last-tick tk
    set pv-event-ticks lput tk pv-event-ticks
    set pv-event-values lput value pv-event-values
    set pv-event-rates lput rate pv-event-rates
  ]
end

;; task context: events [tick rate-change jump]
to-report task-pv-events
  ifelse finish-tick > start-tick [
    let rate planned-hours / (finish-tick - start-tick)
    report (list (list start-tick rate 0) (list finish-tick (- rate) 0))
  ][
    report (list (list finish-tick 0 planned-hours))
  ]
end

;; Planned value accumulated by time t
to-report planned-value-at [t]
  if bac-total <= 0 or empty? pv-event-ticks [report 0]
  if t < first pv-event-ticks [report 0]
  ;; last event at or before t
  let lo 0
  let hi (length pv-event-ticks) - 1
  while [lo < hi] [
    let mid ceiling ((lo + hi) / 2)
    ifelse item mid pv-event-ticks <= t [set lo mid][set hi mid - 1]
  ]
  report min (list bac-total ((item lo pv-event-values) + (item lo pv-event-rates) * (t - item lo pv-event-ticks)))
end

;; EV, AC and PV are used by many monitors, plots and derived reporters, so they are summed once
;; per tick and cached. The state only changes inside go, before the tick.
to refresh-evm-cache
  if cache-tick != ticks [
    set cache-ev sum [complete-hours] of tasks
    set cache-ac sum [actual-hours] of tasks
    set cache-pv planned-value-at ticks
    set cache-tick ticks
  ]
end

to-report PV
  if bac-total <= 0 [report 0]
  refresh-evm-cache
  report cache-pv
end

;; Actual Cost: hours actually spent on tasks
to-report AC
  if bac-total <= 0 [report 0]
  refresh-evm-cache
  report cache-ac
end

;; Earned Value: planned hours of the work actually accomplished
to-report EV
  if bac-total <= 0 [report 0]
  refresh-evm-cache
  report cache-ev
end

to-report PV%
  ifelse BAC > 0 [report (PV / BAC)][report 1]
end

to-report EV%
  ifelse BAC > 0 [report (EV / BAC)][report 1]
end

to-report AC%
  ifelse BAC > 0 [report (AC / BAC)][report 1]
end

to-report SV
  report EV - PV
end

to-report CV
  report EV - AC
end

to-report SV%
  ifelse PV > 0 [report SV / PV][report 0]
end

to-report CV%
  ifelse EV > 0 [report CV / EV][report 0]
end

;; SPI and CPI report the neutral value 1 until there is data (PV or AC > 0)
to-report SPI
  ifelse PV > 0 [report EV / PV][report 1]
end

to-report CPI
  ifelse AC > 0 [report EV / AC][report 1]
end

;; Undefined ("n/a") when the budget is exhausted but work remains
to-report TCPI
  ifelse (BAC - AC) > 0
    [report (BAC - EV) / (BAC - AC)]
    [ifelse BAC - EV <= 0 [report 1][report "n/a"]]
end

;; Estimate at Completion, assuming the remaining work is done at the budgeted rate: BAC - CV
to-report EAC1
  report BAC - CV
end

;; Estimate at Completion, assuming the current cost performance continues: BAC / CPI
to-report EAC2
  ifelse CPI > 0 [report BAC / CPI][report "n/a"]
end

to-report ETC
  report EAC1 - AC
end

to-report ETC2
  ifelse is-number? EAC2 [report EAC2 - AC][report "n/a"]
end

to-report VAC
  report BAC - EAC1
end

to-report VAC%
  ifelse BAC > 0 [report VAC / BAC][report 0]
end

to-report CPIAC
  ifelse EAC1 > 0 [report BAC / EAC1][report 1]
end

;; Earned Schedule: the time at which the baseline planned to have earned the current EV
to-report ES
  if bac-total <= 0 [report 0]
  refresh-evm-cache
  if cache-es-tick != ticks [
    set cache-es compute-es
    set cache-es-tick ticks
  ]
  report cache-es
end

to-report compute-es
  if BAC <= 0 [report 0]
  let earned min (list EV BAC)
  if earned <= 0 [report 0]
  ;; the baseline already planned that much at time 0 (for example zero-duration tasks at the start)
  if planned-value-at 0 >= earned [report 0]
  ;; earliest time at which the baseline planned to have earned that much (binary search + interpolation)
  let lo 0
  let hi PMB-Duration
  while [hi - lo > 1] [
    let mid floor ((lo + hi) / 2)
    ifelse planned-value-at mid >= earned [set hi mid][set lo mid]
  ]
  let pl planned-value-at lo
  let ph planned-value-at hi
  report ifelse-value ph > pl [lo + (earned - pl) / (ph - pl)][hi]
end

;; Time-based schedule performance index (earned schedule / actual time)
to-report SPIt
  ifelse ticks > 0 [report ES / ticks][report 0]
end

;; Time Estimate at Completion: planned duration / SPI(t). Undefined ("n/a") until some progress is earned.
;; Unlike PMB / SPI, this equals the real duration once the project finishes.
to-report EACt
  ifelse SPIt > 0 [report PMB-Duration / SPIt][report "n/a"]
end
